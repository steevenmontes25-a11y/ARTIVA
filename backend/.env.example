APP_NAME=ARTIVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Para probar desde un dispositivo físico (no emulador/navegador de esta PC),
# cambia esto a tu IP de LAN (ej. http://192.168.1.50:8000) — las URLs de
# media que genera LocalMediaStorage se arman a partir de APP_URL, y
# "localhost" solo resuelve dentro de esta misma máquina. Mismo criterio que
# EXPO_PUBLIC_API_URL en el .env del frontend.
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=artiva
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@artiva.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum / CORS (app Expo en dev) ---
# Nota: la app móvil se autentica con Bearer tokens (auth:sanctum), no con el
# guard "stateful" de cookies (ese es solo para SPAs web). Esta lista solo
# importa si en el futuro se sirve un panel web que use cookies de sesión.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8081,127.0.0.1,127.0.0.1:8081
SESSION_SECURE_COOKIE=false
FRONTEND_URL=http://localhost:8081

# --- Firebase Cloud Messaging (push) ---
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=storage/app/firebase/service-account.json

# --- Laravel Reverb (WebSockets tiempo real) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
